{
  "name": "@lukaisailovic/remarkable-mcp",
  "version": "0.2.1",
  "description": "MCP server for a reMarkable tablet over SSH or rmfakecloud, with Cloudflare Code Mode.",
  "keywords": [
    "codemode",
    "mcp",
    "remarkable"
  ],
  "homepage": "https://github.com/lukaisailovic/remarkable-mcp#readme",
  "bugs": "https://github.com/lukaisailovic/remarkable-mcp/issues",
  "license": "MIT",
  "author": "Luka Isailovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukaisailovic/remarkable-mcp.git"
  },
  "bin": {
    "remarkable-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx watch --env-file=.env src/index.ts --http",
    "lint": "oxlint --type-aware --type-check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/codemode": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "beautiful-mermaid": "^1.1.3",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "ssh2": "^1.17.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/ssh2": "^1.15.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0"
}
