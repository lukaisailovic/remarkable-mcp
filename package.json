{
  "name": "remarkable-mcp",
  "version": "0.1.0",
  "description": "SSH-only MCP server for a reMarkable tablet, with Cloudflare Code Mode.",
  "type": "module",
  "bin": {
    "remarkable-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "remarkable",
    "codemode"
  ],
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/codemode": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "beautiful-mermaid": "^1.1.3",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "ssh2": "^1.17.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
